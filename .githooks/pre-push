#!/bin/sh

echo ""
echo "========================================================"
echo " [GIT HOOK] Running automated tests before git push... "
echo "========================================================"

# Run test suite
if command -v npm.cmd >/dev/null 2>&1; then
  npm.cmd test
else
  npm test
fi

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "========================================================"
  echo " [ERROR] Tests failed! Git push has been cancelled."
  echo " Fix the failing test(s) before pushing your changes."
  echo "========================================================"
  echo ""
  exit 1
fi

echo ""
echo " [SUCCESS] All 97 tests passed cleanly. Proceeding with push."
echo "========================================================"
echo ""
exit 0

